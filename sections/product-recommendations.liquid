{%- comment -%} Doporučené produkty (Shopify Search & Discovery). Načítají se přes Section Rendering API. {%- endcomment -%}
<section class="sekce" data-doporuceni{% if section.settings.kolekce == blank %} data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.pocet }}"{% endif %}>
  {%- if section.settings.kolekce != blank -%}
    <div class="obal">
      <div class="sekce__hlava"><div><h2>{{ section.settings.nadpis | escape }}</h2></div><a class="odkaz sipka" href="{{ routes.all_products_collection_url }}">{{ 'general.all_products' | t }}</a></div>
      <ul class="produkty">
        {%- assign ukazano = 0 -%}
        {%- for p in section.settings.kolekce.products -%}
          {%- if p.id != product.id and ukazano < section.settings.pocet -%}{% render 'product-card', card_product: p %}{%- assign ukazano = ukazano | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- elsif recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="obal">
      <div class="sekce__hlava"><div><h2>{{ section.settings.nadpis | escape }}</h2></div><a class="odkaz sipka" href="{{ routes.all_products_collection_url }}">{{ 'general.all_products' | t }}</a></div>
      <ul class="produkty">
        {%- for p in recommendations.products -%}{% render 'product-card', card_product: p %}{%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>
{%- if section.settings.kolekce != blank -%}{% render 'konfigurator-profily' %}<script src="{{ 'potisk.js' | asset_url }}" defer></script>{%- endif -%}
<script>
  (function () {
    var s = document.currentScript.previousElementSibling;
    if (!s || s.children.length || !s.dataset.url) return;
    fetch(s.dataset.url).then(function (r) { return r.text(); }).then(function (h) {
      var n = new DOMParser().parseFromString(h, 'text/html').querySelector('[data-doporuceni]');
      if (n && n.children.length) { s.innerHTML = n.innerHTML; if (window.Mariva) Mariva.vykresliKarty(s); }
    });
  })();
</script>
{% schema %}
{
  "name": "Doporučené produkty",
  "settings": [
    {"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Mohlo by se hodit"},
    {"type": "collection", "id": "kolekce", "label": "Ruční výběr z kolekce", "info": "Když vyberete kolekci, ukážou se její produkty. Bez výběru doporučuje Shopify sám (potřebuje čas na data)."},
    {"type": "range", "id": "pocet", "label": "Počet produktů", "min": 2, "max": 8, "step": 1, "default": 4}
  ]
}
{% endschema %}
