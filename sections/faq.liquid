<section class="sekce{% if section.settings.podklad %} sekce--papir2{% endif %}">
  <div class="obal otazky">
    <div>
      <h2>{{ section.settings.nadpis | escape }}</h2>
      <div class="tlumene">{{ section.settings.text }}</div>
    </div>
    <div>
      {%- for block in section.blocks -%}
        <details{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.otazka | escape }}</summary>
          <div class="richtext" style="padding:0 0 18px">{{ block.settings.odpoved | replace: '{termin}', '<span data-termin>do 3 až 5 týdnů</span>' }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {"@type": "Question", "name": {{ block.settings.otazka | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.odpoved | strip_html | replace: '{termin}', settings.dodani_text | json }}}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "Časté otázky",
  "settings": [
    {"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Časté otázky"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Nenašli jste odpověď? Zavolejte nám nebo napište e-mail.</p>"},
    {"type": "checkbox", "id": "podklad", "label": "Tmavší podklad sekce", "default": true}
  ],
  "blocks": [
    {
      "type": "otazka",
      "name": "Otázka",
      "settings": [
        {"type": "text", "id": "otazka", "label": "Otázka", "default": "Jak dlouho výroba trvá?"},
        {"type": "richtext", "id": "odpoved", "label": "Odpověď", "default": "<p>Dodáváme do 3 až 5 týdnů od objednávky. Při objednávce dnes je hotovo {termin}.</p>", "info": "{termin} se nahradí termínem dodání."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Časté otázky",
      "blocks": [
        {"type": "otazka", "settings": {"otazka": "Jak dlouho výroba trvá?", "odpoved": "<p>Dodáváme do 3 až 5 týdnů od objednávky. Při objednávce dnes je hotovo {termin}. Pokud to spěchá, zavolejte nám a domluvíme se.</p>"}},
        {"type": "otazka", "settings": {"otazka": "Jak můžu zaplatit?", "odpoved": "<p>Způsob platby vyberete v pokladně: online kartou, převodem, nebo podle nabídky obchodu i na dobírku.</p>"}},
        {"type": "otazka", "settings": {"otazka": "V jakém formátu poslat obrázek nebo logo?", "odpoved": "<p>Stačí JPG nebo PNG, logo klidně i v PDF. Čím větší rozlišení, tím ostřejší potisk. Konfigurátor vám rovnou ukáže, jestli obrázek pro tisk stačí.</p>"}},
        {"type": "otazka", "settings": {"otazka": "Můžu objednat jen jedno tričko?", "odpoved": "<p>Ano, tričko s vlastním potiskem objednáte v konfigurátoru i po jednom kusu. Pro celou třídu nebo tým nám pošlete poptávku a připravíme nabídku.</p>"}},
        {"type": "otazka", "settings": {"otazka": "Jak objednat trička pro celou třídu s různými velikostmi?", "odpoved": "<p>Pošlete poptávku s rozpisem velikostí, případně se seznamem jmen na záda. Ozveme se vám s cenou a návrhem.</p>"}}
      ]
    }
  ]
}
{% endschema %}
