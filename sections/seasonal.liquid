{%- comment -%} Sezónní nabídka: ukáže se blok, jehož měsíce odpovídají dnešku (jinak první). {%- endcomment -%}
<section class="sekce" data-sezona-sekce>
  {%- for block in section.blocks -%}
    <div class="obal sezona" data-sezona-blok="{{ block.settings.mesice | escape }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
      <div class="sezona__obraz" aria-hidden="true">
        {%- for i in (1..3) -%}
          {%- assign klic = 'ilustrace_' | append: i -%}
          {%- assign klic_p = 'produkt_' | append: i -%}
          {%- render 'obrazek-produktu', produkt: block.settings[klic_p], ilustrace: block.settings[klic], sirka: 700 -%}
        {%- endfor -%}
      </div>
      <div>
        <h2>{{ block.settings.nadpis | escape }}</h2>
        <p>{{ block.settings.text | escape }}</p>
        {%- assign polozky = block.settings.polozky | newline_to_br | split: '<br />' -%}
        <ul class="zaskrtnute">
          {%- for polozka in polozky -%}{%- assign p = polozka | strip -%}{%- if p != blank -%}<li>{{ p | escape }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        <div class="termin"><svg aria-hidden="true"><use href="#i-kalendar"/></svg><div>{{ section.settings.termin_text | escape }} <strong data-termin>{{ settings.dodani_text | escape }}</strong>.</div></div>
        <div class="tlacitka">
          {%- if block.settings.tlacitko != blank -%}<a class="tl tl--magenta tl--velke" href="{{ block.settings.tlacitko_odkaz | default: routes.all_products_collection_url }}">{{ block.settings.tlacitko | escape }}</a>{%- endif -%}
          {%- if block.settings.odkaz_text != blank -%}<a class="tl tl--velke" href="{{ block.settings.odkaz | default: routes.all_products_collection_url }}">{{ block.settings.odkaz_text | escape }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Sezónní nabídka",
  "settings": [
    {"type": "text", "id": "termin_text", "label": "Věta před termínem", "default": "Objednáte-li dnes, máte hotovo"}
  ],
  "blocks": [
    {
      "type": "sezona",
      "name": "Sezóna",
      "settings": [
        {"type": "text", "id": "mesice", "label": "Měsíce (čísla oddělená čárkou)", "default": "9,10,11,12,1"},
        {"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Stužkovák se blíží. Šerpy máte v suchu."},
        {"type": "textarea", "id": "text", "label": "Text", "default": "Šerpy, stužky, trička i mikiny pro celou třídu z jedné tiskárny. Pošlete nám název třídy, rok maturity a seznam jmen a my se vám ozveme s nabídkou."},
        {"type": "textarea", "id": "polozky", "label": "Seznam (jedna položka na řádek)", "default": "Šerpy se jménem pro každého\nAtlasové stužky s názvem školy a rokem\nTrička a mikiny s rokem maturity\nPlacky a drobnosti pro celou třídu"},
        {"type": "text", "id": "tlacitko", "label": "Hlavní tlačítko", "default": "Poptat pro třídu"},
        {"type": "url", "id": "tlacitko_odkaz", "label": "Odkaz hlavního tlačítka", "info": "Např. stránka s poptávkou nebo produkt Šerpa."},
        {"type": "text", "id": "odkaz_text", "label": "Druhé tlačítko", "default": "Vše pro maturanty"},
        {"type": "url", "id": "odkaz", "label": "Odkaz druhého tlačítka"},
        {"type": "product", "id": "produkt_1", "label": "Produkt 1", "info": "Na obrázku se ukážou fotky vybraných produktů."},
        {"type": "product", "id": "produkt_2", "label": "Produkt 2"},
        {"type": "product", "id": "produkt_3", "label": "Produkt 3"},
        {"type": "select", "id": "ilustrace_1", "label": "Ilustrace 1 (když produkt nemá fotku)", "default": "serpa", "options": [{"value": "serpa", "label": "Šerpa"}, {"value": "stuzky", "label": "Stužky"}, {"value": "ksiltovka", "label": "Kšiltovka"}, {"value": "hrnek", "label": "Hrnek"}, {"value": "polstarek", "label": "Polštářek"}, {"value": "placka", "label": "Placka"}, {"value": "propiska", "label": "Propiska"}, {"value": "vak", "label": "Vak"}, {"value": "rucnik", "label": "Ručník"}, {"value": "vesta", "label": "Vesta"}, {"value": "klicenka", "label": "Klíčenka"}, {"value": "puzzle", "label": "Puzzle"}, {"value": "zastera", "label": "Zástěra"}]},
        {"type": "select", "id": "ilustrace_2", "label": "Ilustrace 2 (když produkt nemá fotku)", "default": "stuzky", "options": [{"value": "serpa", "label": "Šerpa"}, {"value": "stuzky", "label": "Stužky"}, {"value": "ksiltovka", "label": "Kšiltovka"}, {"value": "hrnek", "label": "Hrnek"}, {"value": "polstarek", "label": "Polštářek"}, {"value": "placka", "label": "Placka"}, {"value": "propiska", "label": "Propiska"}, {"value": "vak", "label": "Vak"}, {"value": "rucnik", "label": "Ručník"}, {"value": "vesta", "label": "Vesta"}, {"value": "klicenka", "label": "Klíčenka"}, {"value": "puzzle", "label": "Puzzle"}, {"value": "zastera", "label": "Zástěra"}]},
        {"type": "select", "id": "ilustrace_3", "label": "Ilustrace 3 (když produkt nemá fotku)", "default": "placka", "options": [{"value": "serpa", "label": "Šerpa"}, {"value": "stuzky", "label": "Stužky"}, {"value": "ksiltovka", "label": "Kšiltovka"}, {"value": "hrnek", "label": "Hrnek"}, {"value": "polstarek", "label": "Polštářek"}, {"value": "placka", "label": "Placka"}, {"value": "propiska", "label": "Propiska"}, {"value": "vak", "label": "Vak"}, {"value": "rucnik", "label": "Ručník"}, {"value": "vesta", "label": "Vesta"}, {"value": "klicenka", "label": "Klíčenka"}, {"value": "puzzle", "label": "Puzzle"}, {"value": "zastera", "label": "Zástěra"}]}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Sezónní nabídka",
      "blocks": [
        {"type": "sezona", "settings": {"mesice": "9,10,11,12,1"}},
        {"type": "sezona", "settings": {"mesice": "2,3,4,5,6", "nadpis": "Poslední zvonění. Ať je na co vzpomínat.", "text": "Trička a mikiny pro celou třídu, dětské šerpy pro předškoláky a placky na rozloučenou. Pošlete nám seznam jmen a my se vám ozveme s nabídkou.", "polozky": "Trička a mikiny pro třídu\nDětské šerpy na rozloučení se školkou\nPlacky a polštářky na památku\nJména na záda i na rukáv", "ilustrace_1": "serpa", "ilustrace_2": "placka", "ilustrace_3": "polstarek"}},
        {"type": "sezona", "settings": {"mesice": "7,8", "nadpis": "Léto s vlastním tričkem.", "text": "Trička pro tábor, turnaj nebo firemní den. Vaky a kšiltovky k tomu. Napište, kolik vás je, a my se ozveme s nabídkou.", "polozky": "Trička pro tábor a oddíl\nKšiltovky a sportovní vaky\nTrička s logem na firemní akci\nDárky s fotkou z léta", "odkaz_text": "Vše pro sport a spolky", "ilustrace_1": "vak", "ilustrace_2": "ksiltovka", "ilustrace_3": "rucnik"}}
      ]
    }
  ]
}
{% endschema %}
