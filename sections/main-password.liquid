<div class="obal obal--uzky heslo">
  <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="176" height="44">
  <h1>{{ section.settings.nadpis | escape }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'hledani' -%}
    {%- if form.errors -%}<div class="zprava zprava--chyba">{{ form.errors | default_errors }}</div>{%- endif -%}
    <input type="password" name="password" placeholder="{{ 'password.label' | t }}" aria-label="{{ 'password.label' | t }}" required>
    <button type="submit" class="tl tl--magenta">{{ 'password.enter' | t }}</button>
  {%- endform -%}
  <p class="mala"><a href="/admin">{{ 'password.admin' | t }}</a></p>
</div>
{% schema %}
{"name": "Heslo", "settings": [{"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Brzy otevíráme"}]}
{% endschema %}
