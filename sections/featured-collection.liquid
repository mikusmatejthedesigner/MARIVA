{%- liquid
  assign kolekce = section.settings.kolekce
  if kolekce == blank
    assign kolekce = collections.all
  endif
  assign ma_konfigurator = false
  for p in kolekce.products limit: section.settings.pocet
    if p.tags contains 'konfigurator'
      assign ma_konfigurator = true
    endif
  endfor
-%}
{%- if ma_konfigurator -%}{% render 'konfigurator-profily' %}{%- endif -%}
<section class="sekce{% if section.settings.podklad %} sekce--papir2{% endif %}">
  <div class="obal">
    <div class="sekce__hlava">
      <div>
        <h2>{{ section.settings.nadpis | escape }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.odkaz_text != blank -%}<a class="odkaz sipka" href="{{ kolekce.url | default: routes.all_products_collection_url }}">{{ section.settings.odkaz_text | escape }}</a>{%- endif -%}
    </div>
    <ul class="produkty">
      {%- for p in kolekce.products limit: section.settings.pocet -%}
        {% render 'product-card', card_product: p %}
      {%- else -%}
        <li class="tlumene">{{ 'products.no_products' | t }}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- if ma_konfigurator -%}<script src="{{ 'potisk.js' | asset_url }}" defer></script>{%- endif -%}

{% schema %}
{
  "name": "Produkty z kolekce",
  "settings": [
    {"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Co potiskneme"},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Tričko si navrhnete sami a objednáte hned. U ostatních věcí nám pošlete poptávku a my vám pošleme cenu a návrh."},
    {"type": "collection", "id": "kolekce", "label": "Kolekce", "info": "Bez výběru se ukážou všechny produkty."},
    {"type": "range", "id": "pocet", "label": "Počet produktů", "min": 2, "max": 24, "step": 1, "default": 8},
    {"type": "text", "id": "odkaz_text", "label": "Text odkazu na kolekci", "default": "Všechny produkty"},
    {"type": "checkbox", "id": "podklad", "label": "Tmavší podklad sekce", "default": true}
  ],
  "presets": [{"name": "Produkty z kolekce"}]
}
{% endschema %}
