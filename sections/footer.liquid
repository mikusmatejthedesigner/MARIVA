<footer class="paticka">
  <div class="obal">
    <div class="paticka__mrizka">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'znacka' -%}
            <div class="paticka__znacka" {{ block.shopify_attributes }}>
              {%- if settings.logo != blank -%}
                {{ settings.logo | image_url: height: 120 | image_tag: alt: settings.nazev, style: 'height: 44px; width: auto; margin-bottom: 16px' }}
              {%- else -%}
                <img src="{{ 'logo.svg' | asset_url }}" alt="{{ settings.nazev | default: shop.name | escape }}" width="176" height="44">
              {%- endif -%}
              <div class="richtext" style="color:inherit;font-size:15px">{{ block.settings.text }}</div>
            </div>
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h3>{{ block.settings.nadpis | escape }}</h3>
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'kontakt' -%}
            <div class="paticka__kontakt" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.nadpis | escape }}</h3>
              <ul>
                {%- if settings.telefon != blank -%}<li><a href="tel:{{ settings.telefon | remove: ' ' }}">{{ settings.telefon }}</a></li>{%- endif -%}
                {%- if settings.mobil != blank -%}<li><a href="tel:{{ settings.mobil | remove: ' ' }}">{{ settings.mobil }}</a></li>{%- endif -%}
                {%- if settings.email != blank -%}<li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>{%- endif -%}
                {%- if settings.adresa != blank -%}<li>{{ settings.adresa }}</li>{%- endif -%}
                {%- if block.settings.poptavka != blank -%}<li><a href="{{ block.settings.poptavka }}">{{ 'general.write_inquiry' | t }}</a></li>{%- endif -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="paticka__platby">{%- render 'platby' -%}</div>
    <div class="paticka__spodek">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.nazev | default: shop.name }}{% if settings.provozovatel != blank %} · {{ settings.provozovatel }}{% endif %}</span>
      <span>{{ section.settings.spodni_text }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Patička",
  "class": "shopify-section-paticka",
  "settings": [
    {"type": "text", "id": "spodni_text", "label": "Text vpravo dole", "default": "Platba převodem, dobírkou nebo hotově · Osobní odběr ve Všechovicích"}
  ],
  "blocks": [
    {
      "type": "znacka",
      "name": "Logo a text",
      "limit": 1,
      "settings": [
        {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Tiskárna ve Všechovicích. Potiskneme trička, mikiny, šerpy, stužky, hrnky a další věci pro školy, spolky, firmy i jednotlivce.</p>"}
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Produkty"},
        {"type": "link_list", "id": "menu", "label": "Menu", "default": "footer"}
      ]
    },
    {
      "type": "kontakt",
      "name": "Kontakt",
      "limit": 1,
      "settings": [
        {"type": "text", "id": "nadpis", "label": "Nadpis", "default": "Kontakt"},
        {"type": "url", "id": "poptavka", "label": "Odkaz na poptávku", "info": "Stránka se šablonou „poptavka“."}
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
