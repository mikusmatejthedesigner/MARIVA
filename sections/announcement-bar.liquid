{%- comment -%}
  Horní lišta. Se zapnutou sezónní nabídkou se text mění podle měsíce (bloky „Sezóna“ s čísly měsíců).
{%- endcomment -%}
<div class="lista">
  <div class="obal">
    <p data-lista-text>
      {%- if section.settings.odkaz != blank -%}<a href="{{ section.settings.odkaz }}" style="color:inherit;text-decoration:none">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
    </p>
    {%- for block in section.blocks -%}
      <template data-sezona-lista="{{ block.settings.mesice | escape }}" {{ block.shopify_attributes }}>
        {%- if block.settings.odkaz != blank -%}<a href="{{ block.settings.odkaz }}" style="color:inherit;text-decoration:none">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </template>
    {%- endfor -%}
    {%- if section.settings.kontakt -%}
      <div class="lista__kontakt">
        {%- if settings.telefon != blank -%}<a href="tel:{{ settings.telefon | remove: ' ' }}">{{ settings.telefon }}</a>{%- endif -%}
        {%- if settings.email != blank -%}<a href="mailto:{{ settings.email }}">{{ settings.email }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Horní lišta",
  "class": "shopify-section-lista",
  "settings": [
    {"type": "text", "id": "text", "label": "Výchozí text", "default": "Dodáváme do 3 až 5 týdnů od objednávky."},
    {"type": "url", "id": "odkaz", "label": "Odkaz"},
    {"type": "checkbox", "id": "kontakt", "label": "Ukázat telefon a e-mail", "default": true},
    {"type": "paragraph", "content": "Bloky „Sezóna“ nahradí výchozí text v daných měsících (podle data u zákazníka)."}
  ],
  "blocks": [
    {
      "type": "sezona",
      "name": "Sezóna",
      "settings": [
        {"type": "text", "id": "mesice", "label": "Měsíce (čísla oddělená čárkou)", "default": "9,10,11,12,1"},
        {"type": "text", "id": "text", "label": "Text", "default": "Blíží se stužkovací plesy. Šerpy a stužky pro třídu objednejte s předstihem."},
        {"type": "url", "id": "odkaz", "label": "Odkaz"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name": "Horní lišta"}]
}
{% endschema %}
