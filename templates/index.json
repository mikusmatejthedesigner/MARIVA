      "blocks": {
        "otazka_1": {
          "type": "otazka",
          "settings": {
            "otazka": "Jak dlouho výroba trvá?",
            "odpoved": "<p>Dodáváme do 3 až 5 týdnů od objednávky. Při objednávce dnes je hotovo {termin}. Pokud to spěchá, zavolejte nám a domluvíme se.</p>"
          }
        },
        "otazka_2": {
          "type": "otazka",
          "settings": {
            "otazka": "Jak můžu zaplatit?",
            "odpoved": "<p>Způsob platby vyberete v pokladně: online kartou, převodem, nebo podle nabídky obchodu i na dobírku.</p>"
          }
        },
        "otazka_3": {
          "type": "otazka",
          "settings": {
            "otazka": "V jakém formátu poslat obrázek nebo logo?",
            "odpoved": "<p>Stačí JPG nebo PNG, logo klidně i v PDF. Čím větší rozlišení, tím ostřejší potisk. Konfigurátor vám rovnou ukáže, jestli obrázek pro tisk stačí.</p>"
          }
        },
        "otazka_4": {
          "type": "otazka",
          "settings": {
            "otazka": "Můžu objednat jen jedno tričko?",
            "odpoved": "<p>Ano, tričko s vlastním potiskem objednáte v konfigurátoru i po jednom kusu. Pro celou třídu nebo tým nám pošlete poptávku a připravíme nabídku.</p>"
          }
        },
        "otazka_5": {
          "type": "otazka",
          "settings": {
            "otazka": "Jak objednat trička pro celou třídu s různými velikostmi?",
            "odpoved": "<p>Pošlete poptávku s rozpisem velikostí, případně se seznamem jmen na záda. Ozveme se vám s cenou a návrhem.</p>"
          }
        }
      },
