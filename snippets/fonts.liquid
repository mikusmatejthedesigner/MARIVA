{%- comment -%}
  Písma jsou součástí motivu (assets), načítají se z CDN Shopify.
  Archivo: web a nápisy na tričku, Source Serif 4 a Oswald: další písma pro nápisy v konfigurátoru.
{%- endcomment -%}
{%- liquid
  assign latin = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
  assign latin_ext = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF'
-%}
{{ 'archivo-latin-standard-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
<style>
  @font-face { font-family: 'Archivo'; font-style: normal; font-display: swap; font-weight: 100 900; font-stretch: 62% 125%; src: url({{ 'archivo-latin-ext-standard-normal.woff2' | asset_url }}) format('woff2-variations'); unicode-range: {{ latin_ext }}; }
  @font-face { font-family: 'Archivo'; font-style: normal; font-display: swap; font-weight: 100 900; font-stretch: 62% 125%; src: url({{ 'archivo-latin-standard-normal.woff2' | asset_url }}) format('woff2-variations'); unicode-range: {{ latin }}; }
  @font-face { font-family: 'Source Serif 4'; font-style: normal; font-display: swap; font-weight: 200 900; src: url({{ 'source-serif-4-latin-ext-wght-normal.woff2' | asset_url }}) format('woff2-variations'); unicode-range: {{ latin_ext }}; }
  @font-face { font-family: 'Source Serif 4'; font-style: normal; font-display: swap; font-weight: 200 900; src: url({{ 'source-serif-4-latin-wght-normal.woff2' | asset_url }}) format('woff2-variations'); unicode-range: {{ latin }}; }
  @font-face { font-family: 'Oswald'; font-style: normal; font-display: swap; font-weight: 200 700; src: url({{ 'oswald-latin-ext-wght-normal.woff2' | asset_url }}) format('woff2-variations'); unicode-range: {{ latin_ext }}; }
  @font-face { font-family: 'Oswald'; font-style: normal; font-display: swap; font-weight: 200 700; src: url({{ 'oswald-latin-wght-normal.woff2' | asset_url }}) format('woff2-variations'); unicode-range: {{ latin }}; }
</style>
