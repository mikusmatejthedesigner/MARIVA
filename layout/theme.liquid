<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_magenta }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'ikona.svg' | asset_url }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'fonts' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>
      window.MarivaNastaveni = {
        koren: {{ routes.root_url | json }},
        kosik: {{ routes.cart_url | json }},
        kosikPridat: {{ routes.cart_add_url | json }},
        kosikZmenit: {{ routes.cart_change_url | json }},
        kosikTyp: {{ settings.kosik_typ | json }},
        mena: {{ cart.currency.iso_code | json }},
        formatCeny: {{ shop.money_format | json }},
        dodaniOd: {{ settings.dodani_od | json }},
        dodaniDo: {{ settings.dodani_do | json }},
        email: {{ settings.email | json }},
        telefon: {{ settings.telefon | json }},
        barvy: {{ settings.barvy_hex | json }},
        moznosti: {strih: {{ settings.moznost_strih | json }}, barva: {{ settings.moznost_barva | json }}, velikost: {{ settings.moznost_velikost | json }}},
        texty: {potiskChybi: {{ 'configurator.need_print' | t | json }}},
        uploadcare: {klic: {{ settings.uploadcare_klic | json }}, cdn: {{ settings.uploadcare_cdn | json }}}
      };
    </script>
    <script src="{{ 'mariva.js' | asset_url }}" defer></script>
    {{ content_for_header }}
    {%- if template.name == 'index' and settings.adresa contains ', ' -%}
      {%- assign adr = settings.adresa | split: ', ' -%}
      {%- assign psc_mesto = adr[1] | split: ' ' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          "telephone": {{ settings.telefon | json }},
          "email": {{ settings.email | json }},
          "address": {"@type": "PostalAddress", "streetAddress": {{ adr[0] | json }}, "postalCode": {{ psc_mesto[0] | append: ' ' | append: psc_mesto[1] | json }}, "addressLocality": {{ psc_mesto | last | json }}, "addressCountry": "CZ"}
        }
      </script>
    {%- endif -%}
  </head>

  <body class="sablona-{{ template.name }}{% if template.name == 'product' and product.tags contains 'konfigurator' %} stranka-konfigurator{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    {% render 'icon-sprite' %}
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
  </body>
</html>
